# Copy to .env and edit. .env is git-ignored: never commit real keys.
# Variables exported in the shell take precedence over this file.

# Market data source: alpaca | ibkr | mock   (orders are ALWAYS paper-traded in the browser)
DATA_PROVIDER=alpaca

# Default UI language: es | en
APP_LANG=es

# Comma-separated watchlist a new browser starts with (optional; each provider has a default)
# WATCHLIST=SPY,QQQ,AAPL,BTC/USD

# 1 = regular trading hours only for stocks (9:30–16:00 New York), 0 = include pre/post market
USE_RTH=1

# ── Alpaca (https://alpaca.markets → API Keys; a paper account is enough for market data) ──
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# 1 = paper keys, 0 = live keys (they are different key pairs)
ALPACA_PAPER=1
# iex = free for every account · sip = all US exchanges (free plans get it 15 min delayed)
ALPACA_FEED=iex

# ── Interactive Brokers (IB Gateway or TWS running and logged in, API enabled, Read-Only API on) ──
IB_HOST=127.0.0.1
# IB Gateway 4001 live · 4002 paper  |  TWS 7496 live · 7497 paper
IB_PORT=4002
IB_CLIENT_ID=17
# 1 = live (needs a market data subscription) · 3 = delayed
IB_MARKET_DATA_TYPE=3

# Local server
PORT=3000
